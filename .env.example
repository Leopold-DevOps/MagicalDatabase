# Copy to .env.local for local dev. On Render, set these in
# Environment → Add Environment Variable.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Public-facing origin of the site. Required on Render so server-side
# redirects (sign-out, auth callback) and email magic links use the
# public hostname instead of the internal localhost the Node app sees
# behind the proxy. No trailing slash.
# Example: https://magical-database.onrender.com
NEXT_PUBLIC_SITE_URL=
